---
import PageLayout from "../layouts/PageLayout.astro";
import { openSourceContributions, projects } from "../data/projects";
import { siteConfig } from "../site.config";

const meta = {
	description: "About Another Dev, a full-stack engineer and physics student working across systems, cryptography, computational physics, and quantum computing.",
	title: "About",
};

const pullRequestCount = openSourceContributions.reduce(
	(total, contribution) => total + contribution.pullRequests.length,
	0,
);

const focusAreas = [
	{
		index: "01",
		title: "Systems & Languages",
		description: "Rust, interpreters, developer tooling, and Ethereum infrastructure.",
	},
	{
		index: "02",
		title: "Applied Cryptography",
		description: "Zero-knowledge proofs, privacy protocols, and smart contracts.",
	},
	{
		index: "03",
		title: "Computational Science",
		description: "Numerical methods, dynamical systems, and fluid simulation.",
	},
	{
		index: "04",
		title: "Quantum & AI",
		description: "Digital quantum simulation and local retrieval-augmented generation.",
	},
];
---

<PageLayout meta={meta} wide>
	<div class="mx-auto max-w-5xl">
		<header class="border-y border-themeBorder py-10 sm:py-14">
			<div class="grid gap-10 sm:grid-cols-[minmax(0,1.6fr)_minmax(14rem,0.7fr)] sm:gap-14">
				<div>
					<p class="mb-5 font-mono text-xs uppercase tracking-[0.24em] text-accent">Profile / Another Dev</p>
					<h1 class="max-w-2xl text-4xl font-semibold leading-[1.08] !text-textColor sm:text-5xl">
						I build to <span class="text-accent">understand.</span>
					</h1>
					<p class="mt-7 max-w-2xl text-base leading-8 text-textColor/75">
						Full-stack engineer and Physics student at <a class="cactus-link" href="https://www.udea.edu.co/" target="_blank" rel="noreferrer">Universidad de Antioquia</a>, working where computer science, physics, and mathematics meet.
					</p>
				</div>

				<aside class="border-l-2 border-accent pl-5 sm:self-end" aria-label="Current focus">
					<p class="mb-4 font-mono text-[0.7rem] uppercase tracking-[0.2em] text-textColor/45">Current threads</p>
					<ul class="space-y-2.5 text-sm leading-6 text-textColor/75">
						<li>Systems programming</li>
						<li>Privacy and cryptography</li>
						<li>Computational physics</li>
						<li>Quantum computing</li>
					</ul>
				</aside>
			</div>
		</header>

		<section class="grid gap-10 py-14 sm:grid-cols-[minmax(0,1.35fr)_minmax(18rem,0.65fr)] sm:gap-16" aria-labelledby="approach-title">
			<div>
				<p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-accent">Approach</p>
				<h2 class="text-2xl font-semibold !text-textColor" id="approach-title">Between theory and working systems.</h2>
				<p class="mt-5 text-base leading-8 text-textColor/75">
					I use projects as a way to move past surface-level understanding: implement the interpreter, derive and simulate the equations, construct the proof, or test the circuit. That same approach shapes my open-source work on production developer tooling and infrastructure.
				</p>
				<a class="mt-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent" href="/projects/">
					Explore the work <span aria-hidden="true">→</span>
				</a>
			</div>

			<dl class="grid grid-cols-3 border-y border-themeBorder sm:grid-cols-1 sm:border-y-0 sm:border-l sm:pl-8">
				<div class="py-5 sm:border-b sm:border-themeBorder sm:pt-0">
					<dt class="font-mono text-[0.65rem] uppercase tracking-widest text-textColor/45">Projects</dt>
					<dd class="mt-1 text-2xl font-semibold text-accent">{String(projects.length).padStart(2, "0")}</dd>
				</div>
				<div class="border-x border-themeBorder px-4 py-5 sm:border-x-0 sm:border-b sm:px-0">
					<dt class="font-mono text-[0.65rem] uppercase tracking-widest text-textColor/45">OSS repos</dt>
					<dd class="mt-1 text-2xl font-semibold text-accent">{String(openSourceContributions.length).padStart(2, "0")}</dd>
				</div>
				<div class="py-5 sm:pb-0">
					<dt class="font-mono text-[0.65rem] uppercase tracking-widest text-textColor/45">Linked PRs</dt>
					<dd class="mt-1 text-2xl font-semibold text-accent">{String(pullRequestCount).padStart(2, "0")}</dd>
				</div>
			</dl>
		</section>

		<section aria-labelledby="focus-title">
			<div class="mb-6 flex items-center gap-4">
				<h2 class="font-mono text-xs font-normal uppercase tracking-[0.2em] !text-textColor/55" id="focus-title">Working set</h2>
				<span class="h-px flex-1 bg-themeBorder"></span>
			</div>
			<ul class="grid border-l border-t border-themeBorder sm:grid-cols-2">
				{focusAreas.map((area) => (
					<li class="group border-b border-r border-themeBorder p-6 transition-colors hover:bg-surface sm:p-7">
						<div class="flex items-start gap-5">
							<span class="font-mono text-[0.65rem] text-accent/70">{area.index}</span>
							<div>
								<h3 class="text-lg font-semibold !text-textColor transition-colors group-hover:!text-accent">{area.title}</h3>
								<p class="mt-2 leading-6 text-textColor/65">{area.description}</p>
							</div>
						</div>
					</li>
				))}
			</ul>
		</section>

		<section class="mt-14 border border-accent/35 bg-accent/[0.035] p-7 sm:flex sm:items-end sm:justify-between sm:gap-10 sm:p-9" aria-labelledby="contact-title">
			<div class="max-w-xl">
				<p class="mb-3 font-mono text-xs uppercase tracking-[0.2em] text-accent">Contact</p>
				<h2 class="text-2xl font-semibold !text-textColor" id="contact-title">Let’s take on a problem worth solving.</h2>
				<p class="mt-3 leading-7 text-textColor/70">I’m open to engineering roles, technical collaborations, and open-source projects—especially where rigorous ideas need to become working software.</p>
			</div>
			<div class="mt-7 flex shrink-0 flex-wrap gap-x-5 gap-y-3 font-mono text-xs sm:mt-0">
				<a class="border-b border-textColor/30 pb-1 hover:border-accent hover:text-accent" href={`mailto:${siteConfig.email}`}>Email →</a>
				<a class="border-b border-textColor/30 pb-1 hover:border-accent hover:text-accent" href={siteConfig.linkedin} target="_blank" rel="me noreferrer">LinkedIn ↗</a>
				<a class="border-b border-textColor/30 pb-1 hover:border-accent hover:text-accent" href={siteConfig.github} target="_blank" rel="me noreferrer">GitHub ↗</a>
			</div>
		</section>
	</div>
</PageLayout>
