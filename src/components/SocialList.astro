---
import { siteConfig } from "../site.config";

const socialLinks = [
	{ label: "GitHub", href: siteConfig.github, external: true },
	{ label: "LinkedIn", href: siteConfig.linkedin, external: true },
	{ label: "Email", href: `mailto:${siteConfig.email}`, external: false },
];
---

<nav class="flex flex-wrap items-center gap-x-5 gap-y-3" aria-label="Contact and social links">
	<p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-textColor/45">Connect</p>
	<ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
		{socialLinks.map(({ label, href, external }) => (
			<li>
				<a
					class="group inline-flex items-center gap-1.5 border-b border-textColor/25 pb-0.5 font-mono text-xs text-textColor/75 transition-colors hover:border-accent hover:text-accent"
					href={href}
					rel={external ? "me noreferrer" : undefined}
					target={external ? "_blank" : undefined}
				>
					{label}
					<span class="text-[0.65rem] text-accent/60 transition-transform group-hover:translate-x-0.5" aria-hidden="true">
						{external ? "↗" : "→"}
					</span>
				</a>
			</li>
		))}
	</ul>
</nav>
