---
import { Icon } from "astro-icon/components";
import { siteConfig } from "../site.config";

/** 
	Uses https://www.astroicon.dev/getting-started/
	Find icons via guide: https://www.astroicon.dev/guides/customization/#open-source-icon-sets
	Only installed pack is: @iconify-json/mdi
*/
const socialLinks: {
	friendlyName: string;
	isIdentity?: boolean;
	link: string;
	name: string;
	newTab?: boolean;
}[] = [
	{
		friendlyName: "Github",
		isIdentity: true,
		link: siteConfig.github,
		name: "mdi:github",
		newTab: true,
	},
	{
		friendlyName: "LinkedIn",
		isIdentity: true,
		link: siteConfig.linkedin,
		name: "mdi:linkedin",
		newTab: true,
	},
	{
		friendlyName: `Email ${siteConfig.email}`,
		link: `mailto:${siteConfig.email}`,
		name: "mdi:email-outline",
	},
];
---

<div class="flex flex-wrap items-end gap-x-2">
	<p>Find me on</p>
	<ul class="flex flex-1 items-center gap-x-2 sm:flex-initial">
		{
			socialLinks.map(({ friendlyName, isIdentity, link, name, newTab }) => (
				<li class="flex">
					<a
						class="inline-block sm:hover:text-link"
						href={link}
						rel={isIdentity ? "me noreferrer" : undefined}
						target={newTab ? "_blank" : undefined}
					>
						<Icon aria-hidden="true" class="h-8 w-8" focusable="false" name={name} />
						<span class="sr-only">{friendlyName}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>
